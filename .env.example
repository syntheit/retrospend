# Generate using openssl rand -base64 32
AUTH_SECRET=""

PUBLIC_URL="https://www.yourdomain.com"
# TRUSTED_ORIGINS="https://tunnel.yourdomain.com,https://other.yourdomain.com"

POSTGRES_PASSWORD="password"
POSTGRES_USER="postgres"
POSTGRES_DB_NAME="retrospend"

# if you're running Retrospend in a dev environment, you may want to change the address to localhost
DATABASE_URL="postgresql://postgres:password@postgres:5432/retrospend"
SIDECAR_URL="http://localhost:8080"

# Optional. The app and the sidecar connect as the retrospend_owner role, whose
# password is derived from POSTGRES_PASSWORD, so you need not set this. Set it
# only to give that role a secret of its own, and set the same value on both the
# app and the sidecar, or on neither. It is also what lets the switch happen when
# the database user has no password. See docs/self-hosting.md.
# DATABASE_OWNER_PASSWORD=""

# Optional
# SHOW_LANDING_PAGE=true
# ENABLE_LEGAL_PAGES=true
# Generate using openssl rand -base64 32
WORKER_API_KEY="your-api-key-here"
LLM_MODEL="qwen2.5:7b"
# Ollama endpoint for local AI (default: http://ollama:11434/api/generate for Docker container)
# Use http://host.docker.internal:11434/api/generate if Ollama runs on host instead of Docker
# OLLAMA_ENDPOINT="http://ollama:11434/api/generate"

# Server master key for data encryption (optional)
# 64 hex characters, made with: openssl rand -hex 32
# Or DATA_MASTER_KEY_FILE=/path/to/file. The server will not start if it is malformed.
# Keep a copy apart from your backups and off the data disk. Text sealed with it
# cannot be read without it, and no other copy exists.
# DATA_MASTER_KEY=""

# Seal new text on write (default false). Needs the master key. Once it has been
# on, the master key may never be removed and the server will not start on an
# older build. Read the encryption notes in docs/self-hosting.md first.
# DATA_KEYS_WRITE="false"

# OpenRouter External AI (Optional)
# Enables external AI processing as an alternative to local Ollama
# Get an API key at https://openrouter.ai
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="qwen/qwen-2.5-7b-instruct"

# LLM Import Pipeline Settings (Optional)
# ENRICH_BATCH_SIZE=20        # Merchants per LLM enrichment batch (default: 20)
# ENRICH_CONCURRENCY=3        # Max parallel enrichment LLM calls (default: 3)
# PDF_CONCURRENCY=3           # Max parallel PDF chunk parsing LLM calls (default: 3)

# SMTP Settings (Optional)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASSWORD="your-password"
# EMAIL_FROM="Retrospend <noreply@example.com>"

# Unsubscribe Token Secret (Optional but recommended)
# Used to sign one-click unsubscribe links in notification emails.
# Generate using: openssl rand -base64 32
# Without this, unsubscribe links fall back to requiring login.
# UNSUBSCRIBE_SECRET=""

# UnifiedPush endpoints may not name an IP address or localhost. To use an
# ntfy server on your LAN, list its host (name or IP), comma-separated.
# PUSH_ENDPOINT_ALLOW_HOSTS="ntfy.lan,192.168.1.20"

# Push notifications (Optional). Each sender is off until all of its settings
# are given; with none set the apps poll for changes instead.
#
# Android without Google (UnifiedPush, for example the ntfy app). Generate a
# key pair once and keep it: new keys make every phone register again.
#   node -e "const c=require('crypto').createECDH('prime256v1');c.generateKeys();console.log('VAPID_PUBLIC_KEY='+c.getPublicKey('base64url'));console.log('VAPID_PRIVATE_KEY='+c.getPrivateKey('base64url'))"
# VAPID_PUBLIC_KEY=""    # optional, derived from the private key
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"   # defaults to PUBLIC_URL when that is https
#
# iPhone and iPad (APNs). From your Apple developer account: an APNs auth key
# (.p8), its Key ID, your Team ID and the app's bundle ID. Development builds
# use Apple's sandbox automatically.
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_BUNDLE_ID=""
# APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"   # or APNS_KEY_FILE=/path/AuthKey.p8
#
# More Android app signing certificates, besides the release key already
# served at /.well-known/assetlinks.json (app links and password manager
# autofill). SHA-256 fingerprint(s), comma-separated, like "AB:CD:...".
# ANDROID_APP_CERT_SHA256=""
#
# Where people report a vulnerability, served at /.well-known/security.txt.
# Comma-separated mailto: or https: links. Defaults to the project's private
# GitHub report form, so set it to your own address if you run an instance.
# SECURITY_CONTACT="mailto:security@example.com"
#
# Android with Google Play services (FCM, optional). A Firebase service account
# key (JSON text or a file path).
# FCM_SERVICE_ACCOUNT=""   # or FCM_SERVICE_ACCOUNT_FILE=/path/service-account.json
# FCM_PROJECT_ID=""        # optional, read from the key

# Backup Settings (Optional)
# BACKUP_RETENTION_DAYS=30  # How many days to keep backup files (default: 30)
# BACKUP_CRON="0 3 * * *"  # Cron schedule for automatic backups (default: daily at 3 AM UTC)
# BACKUP_AGE_RECIPIENT=  # age public key (age1...) to encrypt backups to; see docs/self-hosting.md

# Upload Storage (for avatars, project images, receipts)
# In Docker: mounted as a named volume at /data/uploads (no config needed)
# For local dev: set to a local directory path
# UPLOAD_DIR=/data/uploads

# Finished data exports (API v1). Files live 24 hours and are only served to
# their owner. Must NOT be inside UPLOAD_DIR (that directory is public).
# In Docker: mounted as a named volume at /data/exports
# EXPORT_DIR=/data/exports

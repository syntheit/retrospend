{
	"name": "retrospend",
	"version": "0.4.5",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node scripts/next-build.mjs",
		"check": "pnpm typecheck && pnpm lint && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "prisma migrate dev",
		"db:migrate": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
		"db:down": "docker compose -f docker-compose.dev.yml down",
		"db:sync-prod": "bash scripts/sync-dev-db.sh",
		"dev": "prisma migrate deploy && next dev -H 0.0.0.0 -p 2997",
		"dev:test": "prisma migrate deploy && next dev -p 1998",
		"i18n:check": "vitest run src/i18n/catalog-validation.test.ts",
		"lint": "biome lint --diagnostic-level=error --skip=nursery/useTailwindSortedClasses --skip=correctness/useExhaustiveDependencies --skip=correctness/noComponentHookFactories --skip=correctness/noChildrenProp --skip=suspicious/noArrayIndexKey --skip=a11y/noStaticElementInteractions --skip=a11y/useAriaPropsSupportedByRole --skip=a11y/useButtonType --skip=a11y/useKeyWithClickEvents --skip=a11y/useSemanticElements --skip=a11y/useValidAriaRole src e2e",
		"postinstall": "prisma generate && mkdir -p public/images/flags && cp -n node_modules/circle-flags/flags/*.svg public/images/flags/ 2>/dev/null || true && mkdir -p public/images/crypto && cp -n node_modules/cryptocurrency-icons/svg/color/*.svg public/images/crypto/ 2>/dev/null || true && node scripts/generate-crypto-icons-list.mjs",
		"preview": "node scripts/next-build.mjs && next start",
		"start": "next start",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"typecheck": "tsc --noEmit",
		"ui:ratchet": "tsx src/test/uiRules/ratchet.ts",
		"ui:tokens": "tsx src/test/uiRules/build-tokens.ts"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@hookform/resolvers": "^5.9.2",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-progress": "^1.2.1",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slider": "^1.6.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tabs": "^1.2.1",
		"@radix-ui/react-toggle": "^1.2.1",
		"@radix-ui/react-toggle-group": "^1.2.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tabler/icons-react": "^3.49.0",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-table": "^9.3.1",
		"@trpc/client": "^11.19.0",
		"@trpc/react-query": "^11.19.0",
		"@trpc/server": "^11.19.0",
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.7.12",
		"circle-flags": "^2.8.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cryptocurrency-icons": "^0.18.1",
		"date-fns": "^4.4.0",
		"dotenv": "^18.0.8",
		"input-otp": "^1.5.0",
		"jszip": "^3.10.2",
		"libphonenumber-js": "^1.13.15",
		"lucide-react": "1.56.0",
		"next": "^16.4.2",
		"next-intl": "^4.14.9",
		"next-themes": "^0.4.6",
		"nodemailer": "^10.2.0",
		"pdfkit": "^0.20.2",
		"pg": "^8.23.1",
		"prisma": "^7.10.1",
		"qrcode.react": "^4.2.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"react-easy-crop": "^6.2.4",
		"react-hook-form": "^7.90.0",
		"react-is": "^19.3.1",
		"recharts": "3.10.1",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"shiki": "^4.5.0",
		"sonner": "^2.0.8",
		"superjson": "^2.2.6",
		"tailwind-merge": "^3.7.0",
		"vaul": "^1.1.2",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@formatjs/icu-messageformat-parser": "3.5.22",
		"@next/bundle-analyzer": "^16.4.2",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24.19.2",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.5",
		"postcss": "^8.5.31",
		"shadcn": "^4.22.1",
		"simple-icons": "^16.35.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"ct3aMetadata": {
		"initVersion": "7.40.0"
	},
	"packageManager": "pnpm@10.25.0"
}

{
	"name": "retrospend",
	"version": "0.4.4",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node scripts/next-build.mjs",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "prisma migrate dev",
		"db:migrate": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
		"db:down": "docker compose -f docker-compose.dev.yml down",
		"db:sync-prod": "bash scripts/sync-dev-db.sh",
		"dev": "prisma migrate deploy && next dev -H 0.0.0.0 -p 2997",
		"dev:test": "prisma migrate deploy && next dev -p 1998",
		"postinstall": "prisma generate && mkdir -p public/images/flags && cp -n node_modules/circle-flags/flags/*.svg public/images/flags/ 2>/dev/null || true && mkdir -p public/images/crypto && cp -n node_modules/cryptocurrency-icons/svg/color/*.svg public/images/crypto/ 2>/dev/null || true && node scripts/generate-crypto-icons-list.mjs",
		"preview": "node scripts/next-build.mjs && next start",
		"start": "next start",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"ts-node": "ts-node --esm",
		"typecheck": "tsc --noEmit"
	},

{
	"name": "@retrospend/api-contract",
	"version": "0.0.0",
	"private": true,
	"description": "The /api/v1 contract: zod schemas and oRPC routes shared by the server, the typed client and openapi.json.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./budget": "./src/budget/schemas.ts",
		"./common": "./src/common/index.ts",
		"./errors": "./src/common/errors.ts",
		"./feedback-client": "./src/feedback/client.ts",
		"./sync": "./src/sync/wire.ts",
		"./template-fields": "./src/recurring/template-fields.ts",
		"./keys": "./src/keys/index.ts",
		"./openapi": "./src/openapi.ts",
		"./protection-allowed": "./src/protection/v1-allowed.ts",
		"./protection-state": "./src/protection/state.ts",
		"./openapi.json": "./openapi.json"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@orpc/contract": "1.15.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@orpc/openapi": "1.15.7",
		"@orpc/zod": "1.15.7",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}

{
	"components": {
		"schemas": {
			"Money": {
				"description": "An amount in minor units of one currency.",
				"examples": [
					{
						"currency": "ARS",
						"minor": 123450
					}
				],
				"properties": {
					"currency": {
						"description": "ISO 4217 code, or the app's code for a crypto asset.",
						"examples": [
							"USD",
							"ARS",
							"BTC"
						],
						"pattern": "^[A-Z0-9]{2,10}$",
						"type": "string"
					},
					"minor": {
						"description": "Amount in the currency's minor units.",
						"maximum": 9007199254740991,
						"minimum": -9007199254740991,
						"type": "integer"
					}
				},
				"required": [
					"minor",
					"currency"
				],
				"type": "object"
			},
			"Problem": {
				"properties": {
					"code": {
						"enum": [
							"bad_request",
							"validation_failed",
							"invalid_filter",
							"idempotency_key_required",
							"unauthenticated",
							"forbidden",
							"missing_scope",
							"api_disabled",
							"not_found",
							"conflict",
							"idempotency_in_progress",
							"idempotency_replay_unavailable",
							"idempotency_key_reused",
							"rate_limited",
							"internal",
							"not_implemented"
						],
						"type": "string"
					},
					"detail": {
						"type": "string"
					},
					"errors": {
						"items": {
							"properties": {
								"message": {
									"type": "string"
								},
								"path": {
									"description": "Dotted path of the bad field.",
									"type": "string"
								}
							},
							"required": [
								"path",
								"message"
							],
							"type": "object"
						},
						"type": "array"
					},
					"instance": {
						"type": "string"
					},
					"requiredScope": {
						"type": "string"
					},
					"retryAfter": {
						"maximum": 9007199254740991,
						"minimum": -9007199254740991,
						"type": "integer"
					},
					"status": {
						"maximum": 9007199254740991,
						"minimum": -9007199254740991,
						"type": "integer"
					},
					"title": {
						"type": "string"
					},
					"type": {
						"type": "string"
					}
				},
				"required": [
					"type",
					"title",
					"status",
					"code"
				],
				"type": "object"
			}
		},
		"securitySchemes": {
			"apiKeyAuth": {
				"in": "header",
				"name": "x-api-key",
				"type": "apiKey"
			},
			"bearerAuth": {
				"description": "A session token from sign-in or device authorization, or an API key.",
				"scheme": "bearer",
				"type": "http"
			},
			"cookieAuth": {
				"in": "cookie",
				"name": "better-auth.session_token",
				"type": "apiKey"
			}
		}
	},
	"info": {
		"description": "The public Retrospend API. Errors are RFC 9457 problem+json with a stable `code`. Every write needs an `Idempotency-Key`.",
		"title": "Retrospend API",
		"version": "1.0.0"
	},
	"openapi": "3.1.1",
	"paths": {
		"/figures": {
			"get": {
				"operationId": "getFigures",
				"parameters": [
					{
						"allowEmptyValue": true,
						"allowReserved": true,
						"in": "query",
						"name": "ids",
						"required": true,
						"schema": {
							"description": "Comma-separated figure ids, at most 50.",
							"examples": [
								"owed.owedToYou,owed.youOwe"
							],
							"maxLength": 2000,
							"pattern": "^[a-z][A-Za-z0-9.]*(,[a-z][A-Za-z0-9.]*)*$",
							"type": "string"
						}
					},
					{
						"allowEmptyValue": true,
						"allowReserved": true,
						"in": "query",
						"name": "projectId",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"allowEmptyValue": true,
						"allowReserved": true,
						"in": "query",
						"name": "personId",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"allowEmptyValue": true,
						"allowReserved": true,
						"in": "query",
						"name": "accountId",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"figures": {
											"items": {
												"properties": {
													"id": {
														"examples": [
															"owed.owedToYou",
															"spent"
														],
														"pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$",
														"type": "string"
													},
													"lines": {
														"anyOf": [
															{
																"items": {
																	"properties": {
																		"currency": {
																			"anyOf": [
																				{
																					"description": "ISO 4217 code, or the app's code for a crypto asset.",
																					"examples": [
																						"USD",
																						"ARS",
																						"BTC"
																					],
																					"pattern": "^[A-Z0-9]{2,10}$",
																					"type": "string"
																				},
																				{
																					"const": "%"
																				}
																			]
																		},
																		"minor": {
																			"maximum": 9007199254740991,
																			"minimum": -9007199254740991,
																			"type": "integer"
																		}
																	},
																	"required": [
																		"minor",
																		"currency"
																	],
																	"type": "object"
																},
																"type": "array"
															},
															{
																"type": "null"
															}
														]
													}
												},
												"required": [
													"id",
													"lines"
												],
												"type": "object"
											},
											"type": "array"
										}
									},
									"required": [
										"figures"
									],
									"type": "object"
								}
							}
						},
						"description": "OK"
					},
					"400": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Bad request or validation failed"
					},
					"401": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "No valid credentials"
					},
					"403": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Missing scope, or the API is turned off"
					},
					"429": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Rate limited; see Retry-After"
					},
					"500": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Server error"
					}
				},
				"security": [
					{
						"bearerAuth": [
							"read"
						]
					},
					{
						"apiKeyAuth": [
							"read"
						]
					},
					{
						"cookieAuth": [
							"read"
						]
					}
				],
				"summary": "Read figures by id",
				"tags": [
					"Figures"
				],
				"x-required-scope": "read"
			}
		},
		"/me": {
			"get": {
				"operationId": "getMe",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"email": {
											"type": "string"
										},
										"homeCurrency": {
											"type": "string"
										},
										"id": {
											"type": "string"
										},
										"image": {
											"anyOf": [
												{
													"type": "string"
												},
												{
													"type": "null"
												}
											]
										},
										"language": {
											"type": "string"
										},
										"name": {
											"type": "string"
										},
										"principal": {
											"properties": {
												"clientId": {
													"anyOf": [
														{
															"type": "string"
														},
														{
															"type": "null"
														}
													]
												},
												"expiresAt": {
													"anyOf": [
														{
															"format": "date-time",
															"type": "string"
														},
														{
															"type": "null"
														}
													]
												},
												"kind": {
													"enum": [
														"cookie",
														"bearer",
														"device",
														"apiKey"
													],
													"type": "string"
												},
												"scopes": {
													"items": {
														"description": "A permission a token carries.",
														"enum": [
															"read",
															"write:expenses",
															"write:money",
															"write:settings",
															"admin"
														],
														"type": "string"
													},
													"type": "array"
												}
											},
											"required": [
												"kind",
												"scopes",
												"expiresAt",
												"clientId"
											],
											"type": "object"
										},
										"role": {
											"enum": [
												"USER",
												"ADMIN"
											],
											"type": "string"
										},
										"twoFactorEnabled": {
											"type": "boolean"
										},
										"username": {
											"type": "string"
										}
									},
									"required": [
										"id",
										"email",
										"username",
										"name",
										"image",
										"role",
										"homeCurrency",
										"language",
										"twoFactorEnabled",
										"principal"
									],
									"type": "object"
								}
							}
						},
						"description": "OK"
					},
					"400": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Bad request or validation failed"
					},
					"401": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "No valid credentials"
					},
					"403": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Missing scope, or the API is turned off"
					},
					"429": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Rate limited; see Retry-After"
					},
					"500": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Server error"
					}
				},
				"security": [
					{
						"bearerAuth": [
							"read"
						]
					},
					{
						"apiKeyAuth": [
							"read"
						]
					},
					{
						"cookieAuth": [
							"read"
						]
					}
				],
				"summary": "The signed-in user and the credential in use",
				"tags": [
					"Platform"
				],
				"x-required-scope": "read"
			}
		},
		"/server-info": {
			"get": {
				"description": "Public. Clients probe it when connecting to a server URL. The features reflect the caller when it sends credentials.",
				"operationId": "getServerInfo",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"apiVersion": {
											"const": "v1"
										},
										"auth": {
											"properties": {
												"methods": {
													"items": {
														"enum": [
															"password",
															"totp",
															"bearer",
															"apiKey",
															"deviceAuthorization"
														],
														"type": "string"
													},
													"type": "array"
												},
												"signUp": {
													"enum": [
														"open",
														"inviteOnly"
													],
													"type": "string"
												}
											},
											"required": [
												"methods",
												"signUp"
											],
											"type": "object"
										},
										"features": {
											"properties": {
												"apiV1": {
													"type": "boolean"
												},
												"envelopeBudget": {
													"type": "boolean"
												},
												"uiV2": {
													"type": "boolean"
												}
											},
											"required": [
												"apiV1",
												"uiV2",
												"envelopeBudget"
											],
											"type": "object"
										},
										"minClientVersion": {
											"description": "Older app builds must ask the user to update.",
											"type": "string"
										},
										"name": {
											"const": "Retrospend"
										},
										"push": {
											"properties": {
												"transports": {
													"items": {
														"enum": [
															"apns",
															"fcm",
															"unifiedpush"
														],
														"type": "string"
													},
													"type": "array"
												}
											},
											"required": [
												"transports"
											],
											"type": "object"
										},
										"version": {
											"examples": [
												"0.4.5"
											],
											"type": "string"
										}
									},
									"required": [
										"name",
										"version",
										"apiVersion",
										"minClientVersion",
										"features",
										"auth",
										"push"
									],
									"type": "object"
								}
							}
						},
						"description": "OK"
					},
					"400": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Bad request or validation failed"
					},
					"429": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Rate limited; see Retry-After"
					},
					"500": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						},
						"description": "Server error"
					}
				},
				"security": [],
				"summary": "What this server is and supports",
				"tags": [
					"Platform"
				],
				"x-required-scope": "public"
			}
		}
	},
	"servers": [
		{
			"url": "/api/v1"
		}
	]
}

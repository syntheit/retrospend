{
	"about": "Golden cases for parseMoneyInput, formatMoneyDraft, decimalSeparator and groupSeparator (@retrospend/domain/parse). Every client runs this file. parse expects either { minor } or { error }. keystrokes replays typing: each key is appended, \u232b deletes the last character, and every step calls formatMoneyDraft(text, locale, currency, previousDraft). draftFromMinor is the editable text for a saved value; it must parse back to the same minor and be a fixed point of formatMoneyDraft. \u00a0 is a no-break space, \u202f a narrow no-break space, \u2212 the minus sign, \u00d7 times, \u00f7 divide.",
	"parse": [
		{
			"name": "en-US grouped",
			"locale": "en-US",
			"currency": "USD",
			"text": "1,234.56",
			"expected": { "minor": 123456 }
		},
		{
			"name": "en-US plain",
			"locale": "en-US",
			"currency": "USD",
			"text": "1234.56",
			"expected": { "minor": 123456 }
		},
		{
			"name": "en-US whole",
			"locale": "en-US",
			"currency": "USD",
			"text": "12",
			"expected": { "minor": 1200 }
		},
		{
			"name": "trailing decimal while typing",
			"locale": "en-US",
			"currency": "USD",
			"text": "12.",
			"expected": { "minor": 1200 }
		},
		{
			"name": "leading decimal",
			"locale": "en-US",
			"currency": "USD",
			"text": ".5",
			"expected": { "minor": 50 }
		},
		{
			"name": "surrounding spaces",
			"locale": "en-US",
			"currency": "USD",
			"text": "  12.5 ",
			"expected": { "minor": 1250 }
		},
		{
			"name": "en-US millions",
			"locale": "en-US",
			"currency": "USD",
			"text": "1,234,567.89",
			"expected": { "minor": 123456789 }
		},
		{
			"name": "trailing zeros beyond the minor unit are exact",
			"locale": "en-US",
			"currency": "USD",
			"text": "12.500",
			"expected": { "minor": 1250 }
		},
		{
			"name": "000 shortcut after a number",
			"locale": "en-US",
			"currency": "USD",
			"text": "5000",
			"expected": { "minor": 500000 }
		},
		{
			"name": "leading zeros",
			"locale": "en-US",
			"currency": "USD",
			"text": "0005",
			"expected": { "minor": 500 }
		},
		{
			"name": "000 shortcut after a decimal",
			"locale": "en-US",
			"currency": "USD",
			"text": "1.5000",
			"expected": { "minor": 150 }
		},
		{
			"name": "comma that cannot be grouping is ambiguous",
			"locale": "en-US",
			"currency": "USD",
			"text": "1,23",
			"expected": { "error": "ambiguous" }
		},
		{
			"name": "group of four is ambiguous",
			"locale": "en-US",
			"currency": "USD",
			"text": "1,2345",
			"expected": { "error": "ambiguous" }
		},
		{
			"name": "European input in en-US is ambiguous",
			"locale": "en-US",
			"currency": "USD",
			"text": "1.234,56",
			"expected": { "error": "ambiguous" }
		},
		{
			"name": "a misplaced group before the decimal is ambiguous",
			"locale": "en-US",
			"currency": "USD",
			"text": "12,34.5",
			"expected": { "error": "ambiguous" }
		},
		{
			"name": "trailing group separator is ambiguous",
			"locale": "en-US",

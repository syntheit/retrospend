{
	"about": "Golden cases for formatMoney and formatMoneyPair (@retrospend/domain/format). Every client runs this file: web vitest, mobile jest, third-party clients. money.minor is integer minor units (cents, satoshis, fils). A missing money is null or absent. Options default to display code, sign auto, cents auto. \u00a0 is a no-break space, \u202f a narrow no-break space. throws names the error a case must raise.",
	"format": [
		{
			"name": "en-US USD",
			"locale": "en-US",
			"money": { "minor": 123456, "currency": "USD" },
			"expected": "USD\u00a01,234.56"
		},
		{
			"name": "en-US USD asks for a symbol, $ is ambiguous so the code shows",
			"locale": "en-US",
			"money": { "minor": 123456, "currency": "USD" },
			"options": { "display": "symbol" },
			"expected": "USD\u00a01,234.56"
		},
		{
			"name": "es-AR USD",
			"locale": "es-AR",
			"money": { "minor": 123456, "currency": "USD" },
			"expected": "USD\u00a01.234,56"
		},
		{
			"name": "es-AR ARS 7+ digits, whole by default",
			"locale": "es-AR",
			"money": { "minor": 123456700, "currency": "ARS" },
			"expected": "ARS\u00a01.234.567"
		},
		{
			"name": "en-US ARS 7+ digits, whole by default",
			"locale": "en-US",
			"money": { "minor": 123456700, "currency": "ARS" },
			"expected": "ARS\u00a01,234,567"
		},
		{
			"name": "ARS with cents shows them under auto",
			"locale": "en-US",
			"money": { "minor": 123456750, "currency": "ARS" },
			"expected": "ARS\u00a01,234,567.50"
		},
		{
			"name": "ARS cents true keeps .00",
			"locale": "en-US",
			"money": { "minor": 123456700, "currency": "ARS" },
			"options": { "cents": true },
			"expected": "ARS\u00a01,234,567.00"
		},
		{
			"name": "ARS cents false, half to even rounds up from odd",
			"locale": "en-US",
			"money": { "minor": 123456750, "currency": "ARS" },
			"options": { "cents": false },
			"expected": "ARS\u00a01,234,568"
		},
		{
			"name": "ARS cents false, half to even stays on even",
			"locale": "en-US",
			"money": { "minor": 123456850, "currency": "ARS" },
			"options": { "cents": false },
			"expected": "ARS\u00a01,234,568"
		},
		{
			"name": "ARS cents false, above half rounds up",
			"locale": "en-US",
			"money": { "minor": 123456751, "currency": "ARS" },
			"options": { "cents": false },
			"expected": "ARS\u00a01,234,568"
		},
		{
			"name": "es-AR ARS 11 digits",
			"locale": "es-AR",
			"money": { "minor": 1234567890000, "currency": "ARS" },
			"expected": "ARS\u00a012.345.678.900"
		},
		{
			"name": "es-AR groups 4 digits too",
			"locale": "es-AR",
			"money": { "minor": 123400, "currency": "ARS" },
			"expected": "ARS\u00a01.234"
		},
		{
			"name": "largest safe integer",
			"locale": "en-US",
			"money": { "minor": 9007199254740991, "currency": "ARS" },
			"expected": "ARS\u00a090,071,992,547,409.91"
		},
		{
			"name": "COP whole by default",
			"locale": "en-US",
			"money": { "minor": 1234500, "currency": "COP" },
			"expected": "COP\u00a012,345"
		},
		{
			"name": "CLP has no minor unit",
			"locale": "en-US",
			"money": { "minor": 12345, "currency": "CLP" },
			"expected": "CLP\u00a012,345"
		},
		{
			"name": "JPY has no minor unit",
			"locale": "en-US",

			"name": "sign never shows the size only",
			"locale": "en-US",
			"money": { "minor": -1200, "currency": "USD" },
			"options": { "sign": "never" },
			"expected": "USD\u00a012.00"
		},
		{
			"name": "sign never on a positive amount",
			"locale": "en-US",
			"money": { "minor": 1200, "currency": "USD" },
			"options": { "sign": "never" },
			"expected": "USD\u00a012.00"
		},
		{
			"name": "sign auto on a positive amount",
			"locale": "en-US",
			"money": { "minor": 1200, "currency": "USD" },
			"options": { "sign": "auto" },
			"expected": "USD\u00a012.00"
		},

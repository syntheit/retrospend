			"locale": "en-US",
			"money": { "minor": 0, "currency": "BTC" },
			"expected": "BTC\u00a00"
		},
		{
			"name": "zero gets no plus with exceptZero",
			"locale": "en-US",
			"money": { "minor": 0, "currency": "USD" },

{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git"
	},
	"assist": {
		"enabled": true,
		"actions": {
			"preset": "recommended",
			"source": {
				"preset": "recommended",
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"tailwind": {
		"attributes": ["class", "className", "classList"],
		"mergeFunctions": ["clsx", "cn"],
		"variantFunctions": ["cva"]
	},
	"overrides": [
		{
			// @retrospend/domain runs on the server, the web and React Native.
			// packages/domain/boundary.test.ts enforces the same rule in tests.
			"includes": ["packages/domain/src/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "error"
					},
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"next",
											"next/**",
											"react",
											"react/**",
											"react-dom",
											"react-dom/**",
											"react-native",
											"react-native/**",
											"prisma",
											"prisma/**",
											"@prisma/**",
											"server-only",
											"~/**",
											"~prisma"
										],
										"message": "@retrospend/domain may not import a framework, the database client or app code."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}

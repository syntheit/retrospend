{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git"
	},
	"assist": {
		"enabled": true,
		"actions": {
			"preset": "recommended",
			"source": {
				"preset": "recommended",
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"tailwind": {
		"attributes": ["class", "className", "classList"],
		"mergeFunctions": ["clsx", "cn"],
		"variantFunctions": ["cva"]
	},
	"overrides": [
		{
			// Money mutations and figures run inside a preview transaction that
			// always rolls back. The global db opens another connection that
			// commits anyway, so they must use the tx they are given.
			"includes": [
				"src/server/services/**/*.mutation.ts",
				"src/server/services/figures/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/server/db", "**/../db"],
										"message": "Use the tx you are given: the global db commits outside a preview's transaction."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}

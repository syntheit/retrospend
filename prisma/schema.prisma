// Notifications
// ============================================================

enum NotificationType {
  EXPENSE_SPLIT
  VERIFICATION_REQUEST
  EXPENSE_EDITED
  EXPENSE_DELETED
  SETTLEMENT_RECEIVED
  SETTLEMENT_CONFIRMED
  SETTLEMENT_REJECTED
  PERIOD_CLOSED
  PARTICIPANT_ADDED
  PAYMENT_REMINDER
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.VarChar(500)
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notification")
}

model NotificationPreference {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  inApp      Boolean          @default(true)
  email      Boolean          @default(false)
  digestMode Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preference")
}

model UsernameHistory {
  id               String   @id @default(cuid())
  userId           String
  previousUsername  String   @unique @db.VarChar(64)
  changedAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([changedAt])
  @@map("username_history")
}

model Feedback {
  id            String   @id @default(cuid())
  userId        String
  message       String   @db.Text

  // Silent context (collected automatically)
  pageUrl       String
  userAgent     String?
  viewportSize  String?
  appVersion    String?

  // Admin management
  status        String   @default("unread")  // unread, read, archived
  adminNote     String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

// better-auth api-key plugin (@better-auth/api-key; the adapter looks the
// model up as `apikey`). `key` is the SHA-256 hash: the plain key is shown
// once at creation. `permissions` is JSON {"scopes":["read",...]}. Rate
// limits run in /api/v1 (ApiRateLimit), so the plugin's counters stay idle.
model Apikey {
  id                  String    @id
  configId            String    @default("default") @db.VarChar(64)
  name                String?   @db.VarChar(64)
  start               String?   @db.VarChar(32)
  referenceId         String
  prefix              String?   @db.VarChar(32)
  key                 String    @db.VarChar(255)
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  pushDevices         PushDevice[]

  @@index([key])
  @@index([referenceId])
  @@index([configId])
  @@map("apikey")
}

// better-auth device authorization (RFC 8628). A row lives for the code's
// lifetime (30 minutes) and is deleted when redeemed.
model DeviceCode {
  id              String    @id
  deviceCode      String    @unique @db.VarChar(191)
  userCode        String    @unique @db.VarChar(191)
  userId          String?
  expiresAt       DateTime
  status          String    @db.VarChar(16)
  lastPolledAt    DateTime?
  pollingInterval Int?
  clientId        String?   @db.VarChar(64)
  scope           String?   @db.VarChar(255)
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_code")
}

// API v1 Idempotency-Key store (M16): one row per user and key for 24h.
// `completedAt` is null while the first request runs; `responseBody` stays
// null for routes whose response holds a secret.
model IdempotencyKey {
  id           String    @id @default(cuid())
  userId       String
  key          String    @db.VarChar(255)
  requestHash  String    @db.VarChar(64)
  completedAt  DateTime?
  status       Int?
  responseBody Json?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_key")
}

// API v1 rate limit counters (M16): fixed windows per key ("ip:<addr>",
// "tok:<kind>:<id>"), in Postgres so limits survive restarts and hold
// across instances.
model ApiRateLimit {
  key         String   @id @db.VarChar(255)
  windowStart DateTime
  count       Int

  @@index([windowStart])
  @@map("api_rate_limit")
}

enum PushPlatform {
  IOS
  ANDROID
}

enum PushTransport {
  APNS
  FCM
  UNIFIEDPUSH
}

// Push devices (M12): one row per user and address. APNs and FCM rows
// hold a token; UnifiedPush rows an endpoint URL plus the Web Push keys.
// `addressHash` is the SHA-256 of the token or endpoint.
model PushDevice {
  id          String        @id @default(cuid())
  userId      String
  platform    PushPlatform
  transport   PushTransport
  token       String?       @db.VarChar(4096)
  endpoint    String?       @db.VarChar(2048)
  p256dh      String?       @db.VarChar(255)
  auth        String?       @db.VarChar(255)
  addressHash String        @db.VarChar(64)
  apnsSandbox Boolean       @default(false)
  appVersion  String?       @db.VarChar(32)
  deviceName  String?       @db.VarChar(100)
  /// The credential that registered the device; deleting it deletes the row.
  sessionId   String?
  apiKeyId    String?
  lastSeenAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  apiKey      Apikey?       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([userId, transport, addressHash])
  @@index([userId])
  @@index([sessionId])
  @@index([apiKeyId])
  @@map("push_device")
}

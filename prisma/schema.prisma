model AssetAccount {
  id               String          @id @default(cuid())
  userId           String
  name             String
  type             AssetType
  currency         String
  balance          Decimal         @db.Decimal(19, 8)
  exchangeRate     Decimal?        @db.Decimal(18, 6)
  exchangeRateType String?         @db.VarChar(32)
  isLiquid         Boolean         @default(false)
  interestRate     Decimal?        @db.Decimal(9, 6)
  minimumPayment   Decimal?        @db.Decimal(19, 8)
  dueDate          Int?
  /// "Part of my budget" (MONEY-MOVES §2.1). Null = the default for its kind
  /// and currency (accounts/places.ts defaultInBudget).
  inBudget         Boolean?
  /// Units already counted in the budget by a Move in (D4). A later move out
  /// of the account uses them first, so they never enter the budget twice.
  countedUnits     Decimal         @default(0) @db.Decimal(19, 8)
  /// Set when the account is closed. A closed account counts 0 from this day
  /// on but keeps its snapshots, so past net worth stays as it was.
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots        AssetSnapshot[]
  history          AssetHistory[]
  legs             AccountLeg[]
  rateTypes        AssetRateType[]
  transfersOut     Transfer[]      @relation("TransferFrom")
  transfersIn      Transfer[]      @relation("TransferTo")
  liabilityEnvelopes Envelope[]  @relation("EnvelopeLiability")
  wealthTransfers    WealthTransfer[]
  goalEnvelopes      Envelope[]  @relation("EnvelopeWealthAccount")

  @@index([userId])
  @@index([userId, closedAt])
  @@map("asset_account")
}

model AssetSnapshot {
  id               String       @id @default(cuid())
  accountId        String
  userId           String
  date             DateTime
  balance          Decimal      @db.Decimal(19, 8)
  balanceInUSD     Decimal      @db.Decimal(12, 2)
  /// Currency, type and rate type of the account when the snapshot was taken,
  /// so a later edit of the account does not revalue old balances. Null on
  /// rows older than these columns: those fall back to the account's.
  currency         String?
  type             AssetType?
  exchangeRateType String?      @db.VarChar(32)
  /// When this balance was last written: legs of the same day created after
  /// it move the balance on top of it, earlier ones are inside it.
  recordedAt       DateTime     @default(now())
  account          AssetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([userId])
  @@index([userId, date])
  @@map("asset_snapshot")
}

/// M4: a money move between two of your own places, amounts as typed (I21).
/// A null account is Not tracked (N75).
model Transfer {
  id                String       @id @default(cuid())
  userId            String
  kind              TransferKind
  date              DateTime
  fromAccountId     String?
  fromAmount        Decimal      @db.Decimal(19, 8)
  fromCurrency      String
  toAccountId       String?
  toAmount          Decimal      @db.Decimal(19, 8)
  toCurrency        String
  referenceRateType String?      @db.VarChar(32)
  feeExpenseId      String?      @unique
  /// D4: counted units this move took out of the source and gave the destination.
  countedFromUnits  Decimal      @default(0) @db.Decimal(19, 8)
  countedToUnits    Decimal      @default(0) @db.Decimal(19, 8)
  note              String?      @db.VarChar(500)
  createdAt         DateTime     @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount AssetAccount? @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccount   AssetAccount? @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: SetNull)
  feeExpense  Expense?      @relation("TransferFee", fields: [feeExpenseId], references: [id], onDelete: SetNull)
  legs        AccountLeg[]
  budgetSide  WealthTransfer?

  @@index([userId, date])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfer")
}

/// M4: one place a money move changes, signed in what you have (+ = more).
/// accountId null = Not tracked. homeAmount is the booked home value (I20).
model AccountLeg {
  id           String           @id @default(cuid())
  userId       String
  accountId    String?
  currency     String
  amount       Decimal          @db.Decimal(19, 8)
  homeAmount   Decimal?         @db.Decimal(19, 8)
  homeCurrency String?
  date         DateTime
  source       AccountLegSource
  transferId   String?
  expenseId    String?
  /// Units of this leg the budget already counts (D4); the trigger keeps
  /// the account's countedUnits in step with it.
  countedUnits Decimal          @default(0) @db.Decimal(19, 8)
  createdAt    DateTime         @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  AssetAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transfer Transfer?     @relation(fields: [transferId], references: [id], onDelete: Cascade)
  expense  Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([accountId, date])
  @@index([transferId])
  @@index([expenseId])
  @@map("account_leg")
}

/// M4 (D3): the rate type an account is valued at from a day on.
model AssetRateType {
  id        String       @id @default(cuid())
  userId    String
  accountId String
  from         DateTime
  type         String?      @db.VarChar(32)
  /// The account's type before this switch; undo restores it.
  previousType String?      @db.VarChar(32)
  createdAt    DateTime     @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account AssetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Several switches can share a day; createdAt orders them.
  @@index([accountId, from])
  @@index([userId])
  @@map("asset_rate_type")
}


  lockedByPaymentId String?
  // Set on a correction entry (MONEY-MOVES 1.11): the split it corrects. A
  // correction holds only the per-person difference, so its shares may be
  // negative; the original is never rewritten.
  correctsId      String?

  paidByType      ParticipantType
  paidById        String

  createdByType   ParticipantType
  createdById     String

  projectId       String?
  billingPeriodId String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  category        Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  billingPeriod   BillingPeriod?     @relation(fields: [billingPeriodId], references: [id], onDelete: SetNull)
  splitParticipants SplitParticipant[]
  corrects        SharedTransaction?  @relation("Correction", fields: [correctsId], references: [id], onDelete: SetNull)
  corrections     SharedTransaction[] @relation("Correction")
  fixRequests     FixRequest[]

  @@index([paidByType, paidById])
  @@index([createdByType, createdById])
  @@index([correctsId])
  @@index([lockedByPaymentId])
  @@index([projectId])
  @@index([billingPeriodId])
  @@index([billingPeriodId, date])
  @@index([projectId, date])
  @@index([categoryId])
  @@map("shared_transaction")
}

model SplitParticipant {
  id                 String             @id @default(cuid())
  transactionId      String
  participantType    ParticipantType
  participantId      String
  shareAmount        Decimal            @db.Decimal(19, 8)
  sharePercentage    Decimal?           @db.Decimal(5, 2)
  shareUnits         Int?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectionReason    String?            @db.VarChar(500)
  hasUnseenChanges   Boolean            @default(false)
  // The participant's own category for their share (D19): set by them
  // (USER) or by the budget's smart default. The creator's category belongs
  // to the creator and never counts for anyone else.
  categoryId         String?
  categorySource     ShareCategorySource?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  transaction SharedTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category?         @relation("ShareCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([transactionId, participantType, participantId])
  @@index([transactionId])
  @@index([participantType, participantId])
  @@index([verificationStatus])
  @@index([participantType, participantId, transactionId])
  @@index([categoryId])
  @@map("split_participant")
}

// Where a share's category came from (D19).
enum ShareCategorySource {
  USER
  NAME_MATCH
  PROJECT
  PERSON
  TITLE
}

model Settlement {
  id                   String           @id @default(cuid())
  fromParticipantType  ParticipantType
  fromParticipantId    String
  toParticipantType    ParticipantType
  toParticipantId      String
  amount               Decimal          @db.Decimal(19, 8)
  currency             String
  convertedAmount      Decimal?         @db.Decimal(19, 8)
  convertedCurrency    String?
  exchangeRateUsed     Decimal?         @db.Decimal(18, 6)
  paymentMethod        String?          @db.VarChar(191)
  billingPeriodId      String?
  status               SettlementStatus @default(PROPOSED)
  confirmedByPayer     Boolean          @default(false)
  confirmedByPayee     Boolean          @default(false)
  note                 String?          @db.VarChar(500)
  initiatedAt          DateTime         @default(now())
  settledAt            DateTime?
  rejectedAt           DateTime?
  rejectedReason       String?          @db.VarChar(500)
  reminderSentAt       DateTime?
  reminderCount        Int              @default(0)
  autoConfirmedReason  String?          @db.VarChar(200)

  projectId            String?

  // Shared by every row one settle-up call creates (one row per project
  // scope, plus offset rows). Confirm, reject, delete and void act on the
  // whole group. NULL only on legacy single-row payments.
  paymentGroupId       String?
  // An offset row moves no cash: it cancels a debt in one scope against an
  // opposite debt in another scope of the same payment group.
  isOffset             Boolean          @default(false)
  // PAYMENT for money paid (or an offset of one); FORGIVE for a balance let
  // go (2C.2), which moves no cash and is charged to forgiveEnvelopeId.
  kind                 SettlementKind   @default(PAYMENT)
  // Rate type of the conversion when the row's debt currency differs from the
  // payment currency (blue, official, mep, card, custom). With it set,
  // exchangeRateUsed is payment-currency units per 1 unit of `currency`.
  // NULL on same-currency rows and on rows written before payments_corrections.
  rateType             String?          @db.VarChar(32)
  // The envelope a FORGIVE row is charged to, in the creditor's budget.
  forgiveEnvelopeId    String?

  project              Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  forgiveEnvelope      Envelope?        @relation("ForgiveEnvelope", fields: [forgiveEnvelopeId], references: [id], onDelete: SetNull)
  payment              Payment?         @relation(fields: [paymentGroupId], references: [id], onDelete: Cascade)

  @@index([fromParticipantType, fromParticipantId])
  @@index([toParticipantType, toParticipantId])
  @@index([billingPeriodId])
  @@index([status])
  @@index([status, fromParticipantType, fromParticipantId])
  @@index([status, toParticipantType, toParticipantId])
  @@index([projectId], map: "settlement_projectId_idx")
  @@index([projectId, fromParticipantType, fromParticipantId, toParticipantType, toParticipantId], map: "settlement_project_pair_idx")
  @@index([paymentGroupId])
  @@index([forgiveEnvelopeId])
  @@map("settlement")
}

enum SettlementKind {
  PAYMENT
  FORGIVE
}

/// One payment as people see it (MONEY-MOVES §1.1): the header of a payment
/// group. Its id is the rows' paymentGroupId. The rows hold the allocation
/// per scope and debt currency; the header holds what was paid, in the
/// currency it was paid in. Row status and header status move together.
model Payment {
  id             String           @id
  payerType      ParticipantType
  payerId        String
  payeeType      ParticipantType
  payeeId        String
  /// What was paid, in `currency`. 0 for a payment that only offsets.
  amount         Decimal          @db.Decimal(19, 8)
  currency       String
  /// Set when part of the payment converted into exactly one other currency:
  /// `rate` units of `currency` per 1 unit of `rateCurrency`, of `rateType`.
  rateType       String?          @db.VarChar(32)
  rate           Decimal?         @db.Decimal(30, 12)
  rateCurrency   String?
  paymentMethod  String?          @db.VarChar(191)
  /// The day the money moved, as the recorder entered it. "Settled since" uses it.
  paidOn         DateTime         @db.Date
  note           String?          @db.VarChar(500)
  recordedByType ParticipantType
  recordedById   String
  status         SettlementStatus @default(PROPOSED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  settlements Settlement[]

  @@index([payerType, payerId])
  @@index([payeeType, payeeId])
  @@index([status, payeeType, payeeId])
  @@map("payment")
}

enum FixRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  FIXED
  CANCELLED
}

/// Ask to fix (MONEY-MOVES 1.11): a person on a split asks its creator to fix
/// it. The id is made by the client, `updatedAt` is its version. The message
/// is the asker's own text (end-to-end encryption rule 10: its own column);
/// notifications and audit carry the ids only.
model FixRequest {
  id              String           @id
  transactionId   String
  requestedByType ParticipantType
  requestedById   String
  /// Who is asked: the split's creator when it was asked.
  askedType       ParticipantType
  askedId         String
  message         String?          @db.Text
  reply           String?          @db.Text
  status          FixRequestStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  answeredAt      DateTime?
  /// The first correction entry that fixed it.
  fixedById       String?

  transaction SharedTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, status])
  @@index([askedType, askedId, status])
  @@index([requestedByType, requestedById])
  @@map("fix_request")
}

model AuditLogEntry {
  id         String          @id @default(cuid())
  timestamp  DateTime        @default(now())
  actorType  ParticipantType
  actorId    String
  action     AuditAction
  targetType AuditTargetType
  targetId   String
  changes    Json?
  context    Json?
  projectId  String?

  @@index([targetType, targetId])
  @@index([actorType, actorId])
  @@index([projectId])
  @@index([timestamp])
  @@index([action])
  @@map("audit_log_entry")
}

enum ParticipantType {
  user
  guest
  shadow
}

enum SplitMode {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

enum VerificationStatus {
  PENDING
  ACCEPTED
  REJECTED
  AUTO_ACCEPTED
}

enum SettlementStatus {
  PROPOSED
  CONFIRMED
  FINALIZED
  REJECTED
}

enum AuditAction {
  FORGIVEN
  UNFORGIVEN
  CORRECTED
  CORRECTION_UNDONE
  FIX_REQUESTED
  FIX_ANSWERED
  CREATED
  EDITED
  DELETED
  VERIFIED
  REJECTED
  AUTO_VERIFIED
  SETTLED
  PERIOD_CLOSED
  PERIOD_REOPENED
  PARTICIPANT_ADDED
  PARTICIPANT_REMOVED
  ROLE_CHANGED
}

enum AuditTargetType {
  SHARED_TRANSACTION
  SETTLEMENT
  PROJECT
  BILLING_PERIOD
  SPLIT_PARTICIPANT
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
}

enum ProjectRole {
  ORGANIZER
  EDITOR
  CONTRIBUTOR
  VIEWER
}

enum BillingCycleLength {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum BillingPeriodStatus {
  OPEN
  CLOSING
  SETTLED
  ARCHIVED
}

enum BillingClosePermission {
  ORGANIZER_ONLY
  ANY_PARTICIPANT
}

model Project {
  id                       String                 @id @default(cuid())
  name                     String                 @db.VarChar(191)
  description              String?                @db.VarChar(500)
  budgetAmount             Decimal?               @db.Decimal(19, 8)
  budgetCurrency           String?
  primaryCurrency          String                 @default("USD")
  createdById              String
  visibility               ProjectVisibility      @default(PRIVATE)
  status                   ProjectStatus          @default(ACTIVE)
  billingCycleLength       BillingCycleLength?
  billingCycleDays         Int?
  billingAutoClose         Boolean                @default(false)
  billingCloseReminderDays Int                    @default(3)
  billingClosePermission   BillingClosePermission @default(ORGANIZER_ONLY)
  autoAcceptSplits         Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @default(now()) @updatedAt

  imagePath          String?             @db.VarChar(500)

  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants       ProjectParticipant[]
  billingPeriods     BillingPeriod[]
  magicLinks         MagicLink[]
  sharedTransactions SharedTransaction[]
  settlements        Settlement[]

  @@index([createdById])
  @@index([status])
  @@map("project")
}

model ProjectParticipant {
  id                    String          @id @default(cuid())
  projectId             String
  participantType       ParticipantType
  participantId         String
  role                  ProjectRole     @default(CONTRIBUTOR)
  joinedAt              DateTime        @default(now())
  // Membership dates (RC-11): a member on day D joined on or before D and had
  // not left by D. Null joinedOn = member from the project's start; null
  // leftOn = still a member. They choose who new expenses include by
  // default; past splits are never changed by them.
  joinedOn              DateTime?       @db.Date
  leftOn                DateTime?       @db.Date
  // A reports flag only ("Hide from reports"); the budget reads budgetRouting.
  excludeFromAnalytics  Boolean         @default(false)
  // "Count my share in" (D31, D11 revised): by category, one envelope, or
  // not in the budget at all. Only the participant's own budget reads it.
  budgetRouting         ProjectBudgetRouting @default(CATEGORY)
  budgetEnvelopeId      String?

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetEnvelope Envelope? @relation("ProjectBudgetEnvelope", fields: [budgetEnvelopeId], references: [id], onDelete: SetNull)

  @@unique([projectId, participantType, participantId])
  @@index([projectId])
  @@index([participantType, participantId])
  @@index([budgetEnvelopeId])
  @@map("project_participant")
}

enum ProjectBudgetRouting {
  CATEGORY
  ENVELOPE
  NOT_IN_BUDGET
}

model BillingPeriod {
  id         String              @id @default(cuid())
  projectId  String
  label      String              @db.VarChar(100)
  startDate  DateTime
  endDate    DateTime
  status     BillingPeriodStatus @default(OPEN)
  closedById String?
  closedAt   DateTime?
  settledAt  DateTime?
  createdAt  DateTime            @default(now())

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sharedTransactions SharedTransaction[]

  @@index([projectId])
  @@index([status])
  @@map("billing_period")
}


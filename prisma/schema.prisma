generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(cuid())
  name                  String                @db.VarChar(191)
  username              String                @unique @db.VarChar(64)
  email                 String                @unique @db.VarChar(255)
  emailVerified         Boolean               @default(false)
  image                 String?               @db.VarChar(2048)
  homeCurrency          String                @default("USD")
  categoryClickBehavior        CategoryClickBehavior        @default(toggle)
  role                         UserRole                     @default(USER)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt
  defaultCurrency       String                @default("USD")

  currencySymbolStyle         CurrencySymbolStyle           @default(standard)
  monthlyIncome               Decimal?                      @db.Decimal(10, 2)
  monthlyIncomeCurrency       String                        @default("USD")
  smartCurrencyFormatting     Boolean                       @default(true)
  defaultPrivacyMode          Boolean                       @default(false)
  autoAcceptSplits            Boolean                       @default(true)
  fiscalMonthStartDay         Int                           @default(1)
  defaultExpenseDateBehavior  DefaultExpenseDateBehavior    @default(TODAY)
  /// {currency: accountId}: the account money sheets prefill (MONEY-MOVES §2.1).
  defaultAccounts             Json?
  // Default rate type per home currency, {"ARS": "blue"} (M2, N73).
  // Empty uses the built-in default (~/lib/rate-selection).
  defaultRateTypes            Json                          @default("{}")
  /// IANA zone for the user's calendar days; null falls back to DEFAULT_TIME_ZONE.
  timeZone                    String?                       @db.VarChar(64)
  accounts                Account[]
  assetAccounts           AssetAccount[]
  assetSnapshots          AssetSnapshot[]
  assetHistories          AssetHistory[]
  accountLegs             AccountLeg[]
  transfers               Transfer[]
  assetRateTypes          AssetRateType[]
  categories              Category[]
  favoriteExchangeRates   ExchangeRateFavorite[]
  expenses                Expense[]
  budgets                 Budget[]
  recurringTemplates      RecurringTemplate[]
  createdInviteCodes      InviteCode[]                  @relation("CreatedInviteCodes")
  usedInviteCodes         InviteCode[]                  @relation("UsedInviteCodes")
  sessions                Session[]
  pageSettings            UserPageSetting[]
  needsYouSnoozes         NeedsYouSnooze[]
  analyticsPreferences    AnalyticsCategoryPreference[]

  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]
  eventLogs        EventLog[]
  importJobs       ImportJob[]

  language          String    @default("en")
  aiMode            AiMode    @default(LOCAL)
  externalAiAllowed Boolean?
  aiUsages          AiUsage[]

  avatarPath              String?                  @db.VarChar(500)
  lastUsernameChangeAt    DateTime?

  // Pending email change (two-phase verification)
  pendingEmail            String?                  @db.VarChar(255)
  pendingEmailToken       String?                  @unique @db.VarChar(255)
  pendingEmailExpiresAt   DateTime?

  // Consent recording (GDPR / legal pages)
  consentedAt             DateTime?
  consentVersion          String?                  @db.VarChar(20)
  consentIp               String?                  @db.VarChar(45)

  feedback                Feedback[]
  usernameHistory         UsernameHistory[]
  createdShadowProfiles   ShadowProfile[]          @relation("CreatedShadowProfiles")
  claimedShadowProfiles   ShadowProfile[]          @relation("ClaimedShadowProfiles")
  createdProjects         Project[]
  paymentMethods          PaymentMethod[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  budgetBooks             BudgetBook[]             @relation("BudgetBookCreator")
  budgetMemberships       BudgetMember[]

  // API v1 (M11 auth_tokens, M16 idempotency_keys)
  apiKeys                 Apikey[]
  deviceCodes             DeviceCode[]
  idempotencyKeys         IdempotencyKey[]
  pushDevices             PushDevice[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(255)
  userAgent String?  @db.VarChar(255)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // API v1: space-separated scopes and the client id of a session made by
  // device authorization. Null on web and mobile sign-in sessions.
  scopes    String?  @db.VarChar(255)
  clientId  String?  @db.VarChar(64)
  pushDevices PushDevice[]

  @@index([expiresAt])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(64)
  userId                String
  accessToken           String?   @db.VarChar(2048)
  refreshToken          String?   @db.VarChar(2048)
  idToken               String?   @db.VarChar(2048)
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.VarChar(512)
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@unique([providerId, userId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(255)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

model PasswordResetToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("password_reset_token")
}

model Expense {
  id            String        @id @default(cuid())
  userId        String
  title         String
  amount        Decimal       @db.Decimal(19, 8)
  currency      String
  date          DateTime
  categoryId    String?
  amountInUSD   Decimal       @db.Decimal(12, 2)
  exchangeRate  Decimal       @db.Decimal(18, 6)
  pricingSource String
  location      String?       @db.VarChar(191)
  description   String?       @db.VarChar(1000)
  status        ExpenseStatus @default(FINALIZED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Amortization fields
  isAmortizedParent Boolean   @default(false)
  isAmortizedChild  Boolean   @default(false)
  parentId          String?
  parent            Expense?  @relation("AmortizedExpenses", fields: [parentId], references: [id], onDelete: Cascade)
  children          Expense[] @relation("AmortizedExpenses")

  // Recurring subscription reference
  recurringTemplateId String?
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  // Analytics exclusion
  excludeFromAnalytics Boolean @default(false)

  // Money in (M1, budget SPEC §5.2). `amount` stays positive; direction carries
  // the sign. inType is set exactly when direction is IN and entryKind is
  // STANDARD (CHECK expense_in_type_check in the money_in migration).
  direction    ExpenseDirection @default(OUT)
  entryKind    EntryKind        @default(STANDARD)
  inType       InType?
  amortizeMode AmortizeMode     @default(INSTALLMENTS)

  // M4 (MONEY-MOVES §2.2): income kept in Wealth stays out of To assign; its
  // account comes from its AccountLeg. movedInAt: counted in the budget by a
  // Move in (count only, D4).
  keepInWealth Boolean   @default(false)
  // The envelope the budget charges this row to, whatever its category (a debt payment's interest).
  budgetEnvelopeId String?
  movedInAt    DateTime?
  /// The Use my plan batch a recurring confirm assigned; its undo takes it back.
  planBatchId  String?

  // Rate type per entry (M2, N73). rateType names the conversion: an
  // exchange_rate type or "custom". The home leg is booked once, at save, so
  // it never drifts: homeRate is units of homeCurrency per 1 unit of
  // currency (a cross rate, not exchangeRate's per-USD convention) and
  // homeAmount is the value it gave. All three are set or all null (CHECK
  // expense_home_leg_check); null rows (before M2, imports, the sidecar)
  // follow the totals rule in ~/lib/money.
  rateType     String?  @db.VarChar(32)
  homeCurrency String?  @db.VarChar(10)
  homeRate     Decimal? @db.Decimal(28, 12)
  homeAmount   Decimal? @db.Decimal(19, 8)

  /// The Import page: a hash of the file row this came from (import/match.ts),
  /// so a re-import finds it after edits. Null for rows not imported there.
  importFingerprint String? @db.VarChar(64)

  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountLegs AccountLeg[]
  feeOf       Transfer?    @relation("TransferFee")
  // Envelope budget (M6): the starting balance row of a book, and rule movements it fed.
  startingBalanceOf BudgetBook?      @relation("BookStartingBalance")
  budgetMovements   BudgetMovement[] @relation("MovementSourceExpense")
  budgetMoveIn      WealthTransfer?  @relation("WealthTransferSource")

  @@index([userId, date])
  @@index([parentId])
  @@index([recurringTemplateId])
  @@index([userId, date, title, amount, currency])
  @@index([userId, status, date])
  @@index([userId, excludeFromAnalytics, date])
  @@index([userId, isAmortizedParent, date])
  @@index([userId, direction, date])
  @@index([userId, importFingerprint])
  @@index([budgetEnvelopeId])
  @@map("expense")
}

model Category {
  id                   String                        @id @default(cuid())
  name                 String                        @db.VarChar(64)
  color                CategoryColor
  icon                 String?                       @db.VarChar(32)
  isFixed              Boolean                       @default(false)
  excludeByDefault     Boolean                       @default(false)
  // INCOME categories are for money in only, never for spending or envelopes.
  kind                 CategoryKind                  @default(EXPENSE)
  userId               String
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses             Expense[]
  budgets              Budget[]
  recurringTemplates   RecurringTemplate[]
  analyticsPreferences AnalyticsCategoryPreference[]
  sharedTransactions   SharedTransaction[]
  envelopeLinks        EnvelopeCategory[]
  shareCategories      SplitParticipant[]   @relation("ShareCategory")

  @@unique([name, userId])
  @@index([userId])
  @@map("category")
}

model RecurringTemplate {
  id            String             @id @default(cuid())
  userId        String
  name          String             @db.VarChar(191)
  amount        Decimal            @db.Decimal(19, 8)
  currency      String             @default("USD")
  categoryId    String?
  // IN posts money in (recurring income); ASK never posts on its own.
  direction     ExpenseDirection    @default(OUT)
  amountMode    RecurringAmountMode @default(FIXED)
  frequency     RecurringFrequency
  nextDueDate   DateTime
  // Day of month the schedule is anchored to; monthly steps clamp to it so a
  // 31st template lands on Feb 28 and returns to Mar 31.
  anchorDay     Int?
  websiteUrl    String?            @db.VarChar(512)
  paymentSource String?            @db.VarChar(191)
  autoPay       Boolean            @default(true)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenses Expense[]
  envelopes Envelope[]

  @@index([userId, nextDueDate])
  @@index([userId, isActive])
  @@map("recurring_template")
}

model Budget {
  id             String     @id @default(cuid())
  amount         Decimal    @db.Decimal(10, 2)
  currency       String     @default("USD")
  period         DateTime
  isRollover     Boolean    @default(false)
  rolloverAmount Decimal    @default(0) @db.Decimal(10, 2)
  pegToActual    Boolean    @default(false)
  type           BudgetType @default(FIXED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  userId         String
  categoryId     String?
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
  @@index([userId, period])
  @@map("budget")
}

// Envelope budget (M6, budget SPEC §5, build plan 02 §2 and §4). A book holds
// every envelope, group and movement; BudgetMember rows decide access, so a
// household book later adds members instead of re-keying data (D33). Links
// and movements name envelopes through (id, bookId), so a row can never point
// into another book.
model BudgetBook {
  id                       String        @id @default(cuid())
  name                     String        @default("Personal") @db.VarChar(64)
  isPersonal               Boolean       @default(true)
  currency                 String
  style                    BudgetStyle   @default(FLEX)
  fundingSource            FundingSource @default(INCOME)
  // Switched to "Just track": the book is kept, Budget shows tracking (SPEC §4.4).
  pausedAt                 DateTime?
  // 0 = Sunday. Only weekly pace reads it (SPEC §5.1).
  weekStartDay             Int           @default(1)
  // Mirror of the current BookPeriod start day, for queries.
  monthStartDay            Int           @default(1)
  // First budget month whose derived state is stale (checkpoints, P4).
  dirtyFromMonth           Int?
  // Decides only "today" (SPEC §5.1, C21).
  timeZone                 String        @default("UTC") @db.VarChar(64)
  timeZoneConfirmed        Boolean       @default(false)
  startDate                DateTime
  // YYYYMM of the first budget month.
  startMonth               Int
  // "Everything else": required after setup (service invariant).
  defaultEnvelopeId        String?       @unique
  // The STARTING_BALANCE money-in row (D34).
  startingBalanceExpenseId String?       @unique
  startingMoneyConfirmedAt DateTime?
  legacyMigrationRunId     String?       @db.VarChar(64)
  legacyMigratedAt         DateTime?
  // The "your limits moved" notice was dismissed.
  legacyNoticeSeenAt       DateTime?
  // The hidden expenses found at the move, ids only: the review answers stay inside this set and a rollback hides them again.
  legacyHiddenIds          String[]      @default([])
  // Last budget read; 35 days away with closes waiting opens Welcome back (S26).
  lastOpenedAt             DateTime?
  // Welcome back waits from this instant until the person picks a choice.
  welcomeBackFrom          DateTime?
  // Last reconcile; from then on a monthly reminder (SPEC §5.11).
  reconciledAt             DateTime?
  // A switch to Limits funds months from this one on (SPEC §4.4); null = every month.
  planFundFrom             Int?
  // What the last style switch changed; its undo reads this, never the client.
  styleUndo                Json?
  createdById              String
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  createdBy              User      @relation("BudgetBookCreator", fields: [createdById], references: [id], onDelete: Cascade)
  defaultEnvelope        Envelope? @relation("BookDefaultEnvelope", fields: [defaultEnvelopeId, id], references: [id, bookId], onDelete: NoAction)
  startingBalanceExpense Expense?  @relation("BookStartingBalance", fields: [startingBalanceExpenseId], references: [id])
  members   BudgetMember[]
  periods   BookPeriod[]
  groups    EnvelopeGroup[]
  envelopes Envelope[]       @relation("BookEnvelopes")
  links     EnvelopeCategory[]
  movements BudgetMovement[]
  closes    MonthClose[]
  wealthTransfers WealthTransfer[]
  dirtyMarks      BudgetDirty[]
  rowValues       BudgetRowValue[]
  drafts          BudgetDraft[]
  incomeRules     IncomeRule[]
  incomeRuleRuns  IncomeRuleRun[]
  payoffPlan      PayoffPlan?
  envelopeChanges EnvelopeChange[]

  @@index([createdById])
  @@index([currency])
  @@map("budget_book")
}

// What an envelope edit changed, kept server side so its undo is exact and a
// client never supplies the old state. `id` is the client id of the edit, so a
// retry is idempotent. `before` carries ids, amounts and flags only (E2EE rule
// 10); the one user-text value, a name before a rename, has its own column.
model EnvelopeChange {
  id           String             @id
  bookId       String
  kind         EnvelopeChangeKind
  // No foreign key: undoing a create deletes the envelope.
  envelopeId   String?
  previousName String?
  before       Json
  actorUserId  String
  createdAt    DateTime           @default(now())
  undoneAt     DateTime?
  book         BudgetBook         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
  @@map("envelope_change")
}

enum EnvelopeChangeKind {
  SET_TARGET
  CREATE
  UPDATE
  MERGE
  ARCHIVE
  CONFIRM_STARTING_MONEY
}

// Start day and rate type in force from a budget month on (SPEC §5.1, B7).
model BookPeriod {
  id        String     @id @default(cuid())
  bookId    String
  fromMonth Int
  startDay  Int
  rateType  String     @db.VarChar(32)
  createdAt DateTime   @default(now())
  book      BudgetBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, fromMonth])
  @@map("book_period")
}

model BudgetMember {
  id        String           @id @default(cuid())
  bookId    String
  userId    String
  role      BudgetMemberRole @default(OWNER)
  createdAt DateTime         @default(now())
  book      BudgetBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
  @@index([userId])
  @@map("budget_member")
}

model EnvelopeGroup {
  id             String          @id @default(cuid())
  bookId         String
  name           String          @db.VarChar(64)
  sortOrder      Int
  // Which of Flex's three rows the group is (owner r5 Q4); Left to spend sums SPENDING.
  role           GroupRole?
  targetKind     GroupTargetKind @default(NONE)
  // AMOUNT: book currency; PERCENT_OF_INCOME: percent (30.0).
  targetValue    Decimal?        @db.Decimal(19, 8)
  mainEnvelopeId String?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  book           BudgetBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  envelopes      Envelope[]      @relation("GroupEnvelopes")
  mainEnvelope   Envelope?       @relation("GroupMainEnvelope", fields: [mainEnvelopeId], references: [id])

  @@index([bookId, sortOrder])
  @@map("envelope_group")
}

model Envelope {
  id                  String              @id @default(cuid())
  bookId              String
  groupId             String?
  name                String              @db.VarChar(64)
  icon                String?             @db.VarChar(32)
  color               CategoryColor?
  kind                EnvelopeKind        @default(MONTHLY)
  sortOrder           Int
  targetAmount        Decimal?            @db.Decimal(19, 8)
  targetMode          TargetMode          @default(REFILL)
  targetCadence       TargetCadence       @default(MONTH)
  // SAVINGS third variable (SPEC §5.4).
  targetMonthlyAmount Decimal?            @db.Decimal(19, 8)
  // Null = book currency (D25).
  targetCurrency      String?
  targetDueDate       DateTime?           @db.Date
  targetRepeat        RecurringFrequency?
  // First budget month the current target applies to: a target counts from when it was set.
  targetStartMonth    Int?
  // BILL follows a recurring expense (D26) or a liability's minimum (P6).
  targetTemplateId    String?
  targetLiabilityId   String?
  leftoverRule        LeftoverRule        @default(CARRY)
  leftoverSweepToId   String?
  wealthAccountId     String?
  wealthDedicated     Boolean             @default(false)
  // What the last limit edit changed (target and funding); its undo reads this.
  limitUndo           Json?
  archivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  book                BudgetBook          @relation("BookEnvelopes", fields: [bookId], references: [id], onDelete: Cascade)
  group               EnvelopeGroup?      @relation("GroupEnvelopes", fields: [groupId], references: [id])
  targetTemplate      RecurringTemplate?  @relation(fields: [targetTemplateId], references: [id])
  targetLiability     AssetAccount?       @relation("EnvelopeLiability", fields: [targetLiabilityId], references: [id])
  wealthAccount       AssetAccount?       @relation("EnvelopeWealthAccount", fields: [wealthAccountId], references: [id])
  leftoverSweepTo     Envelope?           @relation("EnvelopeSweep", fields: [leftoverSweepToId, bookId], references: [id, bookId], onDelete: NoAction)
  sweptFrom           Envelope[]          @relation("EnvelopeSweep")
  categories          EnvelopeCategory[]
  defaultOf           BudgetBook[]        @relation("BookDefaultEnvelope")
  mainOfGroups        EnvelopeGroup[]     @relation("GroupMainEnvelope")
  movementsOut        BudgetMovement[]    @relation("MovementFrom")
  incomeRules         IncomeRule[]
  payoffPlans         PayoffPlan[]
  movementsIn         BudgetMovement[]    @relation("MovementTo")
  projectRoutes       ProjectParticipant[] @relation("ProjectBudgetEnvelope")
  wealthTransfers     WealthTransfer[]
  forgives            Settlement[]        @relation("ForgiveEnvelope")

  @@unique([id, bookId])
  @@index([bookId, archivedAt])
  @@index([groupId])
  @@map("envelope")
}

model EnvelopeCategory {
  id         String     @id @default(cuid())
  bookId     String
  envelopeId String
  categoryId String
  createdAt  DateTime   @default(now())
  book       BudgetBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  envelope   Envelope   @relation(fields: [envelopeId, bookId], references: [id, bookId], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([bookId, categoryId])
  @@index([envelopeId])
  @@map("envelope_category")
}

// Append-only (D28). Undo appends a mirror row; envelope FKs restrict deletes.
model BudgetMovement {
  // Client id, so retries from any client are idempotent.
  id              String       @id
  bookId          String
  month           Int
  // Null = To assign.
  fromEnvelopeId  String?
  toEnvelopeId    String?
  // > 0, book currency, whole minor units.
  amount          Decimal      @db.Decimal(19, 8)
  kind            MovementKind
  batchId         String?
  revertsId       String?      @unique
  sourceExpenseId String?
  ruleId          String?
  note            String?      @db.VarChar(200)
  actorUserId     String
  createdAt       DateTime     @default(now())
  book            BudgetBook   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  fromEnvelope    Envelope?    @relation("MovementFrom", fields: [fromEnvelopeId, bookId], references: [id, bookId], onDelete: NoAction)
  toEnvelope      Envelope?    @relation("MovementTo", fields: [toEnvelopeId, bookId], references: [id, bookId], onDelete: NoAction)
  reverts         BudgetMovement?  @relation("MovementUndo", fields: [revertsId, bookId], references: [id, bookId], onDelete: NoAction)
  undoneBy        BudgetMovement[] @relation("MovementUndo")
  sourceExpense   Expense?     @relation("MovementSourceExpense", fields: [sourceExpenseId], references: [id])

  @@unique([id, bookId])
  @@index([bookId, month])
  @@index([bookId, createdAt])
  @@index([batchId])
  @@map("budget_movement")
}

// "Just track" is the absence of a book (SPEC §4.1).
enum BudgetStyle {
  LIMITS
  FLEX
  EVERY_DOLLAR
  SAVE_FIRST
  FIFTY_THIRTY_TWENTY
  WEEKLY
  DEBT_PAYOFF
}

enum FundingSource {
  INCOME
  TARGETS
}

enum EnvelopeKind {
  MONTHLY
  BILL
  SAVINGS
  NONE
}

enum TargetMode {
  REFILL
  SET_ASIDE
}

enum TargetCadence {
  MONTH
  WEEK
}

enum LeftoverRule {
  CARRY
  RETURN
  SWEEP
}

enum GroupTargetKind {
  NONE
  AMOUNT
  PERCENT_OF_INCOME
}

enum GroupRole {
  BILLS
  SPENDING
  SAVINGS
}

enum BudgetMemberRole {
  OWNER
  EDITOR
  VIEWER
}

// One closed budget month (SPEC §5.5): what it ended with and the leftover
// rules it closed under, so a later rule change applies from the next close.
model MonthClose {
  id             String         @id @default(cuid())
  bookId         String
  month          Int
  mode           MonthCloseMode @default(AUTO)
  closedAt       DateTime       @default(now())
  revision       Int            @default(1)
  // zod: monthCloseSummarySchema
  summary        Json
  acknowledgedAt DateTime?
  ackRevision    Int?
  // Engine state at the end of the month (checkpoint.ts); null until written.
  checkpoint     Json?
  // What a change after the late window did to today's numbers (C16).
  recalc         Json?
  // Rows added or edited inside the 7-day late window (C17).
  lateEntries    Int            @default(0)
  book           BudgetBook     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, month])
  @@map("month_close")
}

// A budget month whose inputs changed (written by triggers): checkpoints from
// it on are stale until the next read recomputes them (SPEC §5.13).
model BudgetDirty {
  id        BigInt     @id @default(autoincrement())
  bookId    String
  // YYYYMM; 0 = from the book's start.
  fromMonth Int
  createdAt DateTime   @default(now())
  book      BudgetBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("budget_dirty")
}

// A foreign row's book value, frozen the first time the budget values it at
// a rate dated on or before the row: rates are updated in place daily, so a
// later lookup would use today's rate (02 §3.4: values never change).
model BudgetRowValue {
  bookId    String
  // Row id, currency, amount and date: an edited row is valued again.
  key       String     @db.VarChar(400)
  minor     BigInt
  // The date of the book-currency rate used.
  rateDate  DateTime?  @db.Date
  // No rate dated on or before the row at first read: the nearest one, once.
  approximate Boolean  @default(false)
  createdAt DateTime   @default(now())
  book      BudgetBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, key])
  @@map("budget_row_value")
}

// Plan next month (PLAN) and What if (WHAT_IF), SPEC §5.13. A draft is never
// money: expected money in and pretend rows are never written. JSON columns
// carry ids and amounts only (E2EE rule 10); zod: envelope-plan schemas.
model BudgetDraft {
  id            String      @id
  bookId        String
  // PLAN: next month; WHAT_IF: the current or next month.
  month         Int
  kind          DraftKind   @default(PLAN)
  status        DraftStatus @default(OPEN)
  lines         Json        @default("[]")
  moves         Json        @default("[]")
  expectedIn    Json        @default("[]")
  pretend       Json        @default("[]")
  appliedAt     DateTime?
  // The saved plan this one replaced; its undo puts that one back.
  supersedesId  String?
  // "Fund it now": the PLAN_APPLY batch, while it stands.
  fundedBatchId String?
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  book          BudgetBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, month, status])
  @@map("budget_draft")
}

enum DraftKind {
  PLAN
  WHAT_IF
}

enum DraftStatus {
  OPEN
  APPLIED
  DISCARDED
}

// What each money in shares out to envelopes (SPEC §5.10, D71).
model IncomeRule {
  id         String           @id
  bookId     String
  sortOrder  Int
  name       String
  matchKind  IncomeRuleMatch  @default(ANY)
  // CATEGORY: category id; TEMPLATE: template id; CURRENCY: ISO code.
  matchValue String?          @db.VarChar(64)
  // TITLE: the text a title contains (user text, own column).
  matchTitle String?
  action     IncomeRuleAction
  // PERCENT: percent (20.0); AMOUNT: book currency; REMAINDER: null.
  value      Decimal?         @db.Decimal(19, 8)
  envelopeId String
  active     Boolean          @default(true)
  archivedAt DateTime?
  // Rules apply to income rows created after this.
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  book       BudgetBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  envelope   Envelope         @relation(fields: [envelopeId, bookId], references: [id, bookId], onDelete: NoAction)

  @@index([bookId, sortOrder])
  @@map("income_rule")
}

enum IncomeRuleMatch {
  ANY
  CATEGORY
  TEMPLATE
  TITLE
  CURRENCY
}

enum IncomeRuleAction {
  PERCENT
  AMOUNT
  REMAINDER
}

// One row per income row the rules processed: exactly-once runs (SPEC §5.10).
// No relation to expense on purpose: a deleted row's run stays so the next
// read reverts its batch (S16).
model IncomeRuleRun {
  expenseId   String     @id
  bookId      String
  batchId     String?
  skipped     Boolean    @default(false)
  // rules.ts RecordedRun without match text.
  record      Json
  fingerprint String     @db.VarChar(200)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  book        BudgetBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("income_rule_run")
}

// The payoff plan (SPEC §5.11, D72): a projection input, never a ledger.
model PayoffPlan {
  id           String         @id
  bookId       String         @unique
  strategy     PayoffStrategy @default(AVALANCHE)
  // Book currency.
  extraMonthly Decimal        @default(0) @db.Decimal(19, 8)
  // CUSTOM: [assetAccountId] in payoff order.
  customOrder  Json           @default("[]")
  // "Extra debt payment": gets a Set aside target equal to the extra.
  envelopeId   String?
  // What the last save replaced (plan and envelope target), for its undo.
  undo         Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  book         BudgetBook     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  envelope     Envelope?      @relation(fields: [envelopeId, bookId], references: [id, bookId], onDelete: NoAction)

  @@map("payoff_plan")
}

enum PayoffStrategy {
  SNOWBALL
  AVALANCHE
  CUSTOM
}

enum MonthCloseMode {
  AUTO
  USER
}

// The budget's half of a money move (D24, SPEC §5.11). Goes with the transfer
// or the kept income that made it (CASCADE). Amount in the book currency.
model WealthTransfer {
  id              String                  @id
  bookId          String
  direction       WealthTransferDirection
  // TO_WEALTH: the envelope it leaves; FROM_WEALTH: the one it enters. Null = To assign.
  envelopeId      String?
  transferId      String?                 @unique
  // A Move in of income kept in Wealth (countOnly).
  sourceExpenseId String?                 @unique
  assetAccountId  String?
  countOnly       Boolean                 @default(false)
  date            DateTime                @db.Date
  amount          Decimal                 @db.Decimal(19, 8)
  note            String?                 @db.VarChar(200)
  actorUserId     String
  createdAt       DateTime                @default(now())
  book            BudgetBook              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  envelope        Envelope?               @relation(fields: [envelopeId, bookId], references: [id, bookId], onDelete: NoAction)
  transfer        Transfer?               @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sourceExpense   Expense?                @relation("WealthTransferSource", fields: [sourceExpenseId], references: [id], onDelete: Cascade)
  assetAccount    AssetAccount?           @relation(fields: [assetAccountId], references: [id], onDelete: SetNull)

  @@index([bookId, date])
  @@index([envelopeId])
  @@index([assetAccountId])
  @@map("wealth_transfer")
}

enum WealthTransferDirection {
  TO_WEALTH
  FROM_WEALTH
}

enum MovementKind {
  ASSIGN
  SET
  MOVE
  COVER
  UNASSIGN
  AUTO_FILL
  RULE
  PLAN_FUND
  PLAN_APPLY
  CARRY_OVERSPEND
  FIX_NEGATIVE
  RESET
  ARCHIVE

	"security": [
		"_prisma_migrations rls=false force=false",
		"account rls=true force=false",
		"app_settings rls=false force=false",
		"audit_log_entry rls=true force=false",
		"error_report rls=true force=false",
		"event_log rls=false force=false",
		"invite_code rls=false force=false",
		"password_reset_token rls=false force=false",
		"session rls=true force=false",
		"system_status rls=false force=false",
		"twoFactor rls=true force=false",
		"user rls=false force=false",
		"username_history rls=false force=false",
		"verification rls=false force=false",
		"verification_token rls=false force=false"
	],
	"policies": [
		"account account_isolation * (\"userId\" = current_setting('app.current_user_id'::text, true)) | (\"userId\" = current_setting('app.current_user_id'::text, true))",
		"audit_log_entry audit_log_entry_insert a  | ((\"actorType\" = 'user'::\"ParticipantType\") AND (((\"actorId\" = current_setting('app.current_user_id'::text, true)) AND ((\"targetType\" <> 'SETTLEMENT'::\"AuditTargetType\") OR (action <> 'SETTLED'::\"AuditAction\") OR settled_entry_ok(\"targetId\", current_setting('app.current_user_id'::text, true), changes))) OR ((\"actorId\" = '__system__'::text) AND (action = 'AUTO_VERIFIED'::\"AuditAction\") AND (\"targetType\" = 'SPLIT_PARTICIPANT'::\"AuditTargetType\") AND (EXISTS ( SELECT 1\n   FROM (split_participant sp\n     JOIN shared_transaction st ON ((st.id = sp.\"transactionId\")))\n  WHERE ((sp.id = audit_log_entry.\"targetId\") AND (sp.\"participantType\" = 'user'::\"ParticipantType\") AND (sp.\"participantId\" = current_setting('app.current_user_id'::text, true)) AND (sp.\"verificationStatus\" = 'AUTO_ACCEPTED'::\"VerificationStatus\") AND (NOT (st.\"projectId\" IS DISTINCT FROM audit_log_entry.\"projectId\")))))) OR ((\"targetType\" = 'SETTLEMENT'::\"AuditTargetType\") AND (action = 'CREATED'::\"AuditAction\") AND settlement_created_for(\"targetId\", \"actorId\", current_setting('app.current_user_id'::text, true)))))",
		"audit_log_entry audit_log_entry_read r (((\"actorType\" = 'user'::\"ParticipantType\") AND (\"actorId\" = current_setting('app.current_user_id'::text, true))) OR (EXISTS ( SELECT 1\n   FROM shared_transaction st\n  WHERE ((audit_log_entry.\"targetType\" = 'SHARED_TRANSACTION'::\"AuditTargetType\") AND (st.id = audit_log_entry.\"targetId\") AND (((st.\"paidByType\" = 'user'::\"ParticipantType\") AND (st.\"paidById\" = current_setting('app.current_user_id'::text, true))) OR ((st.\"createdByType\" = 'user'::\"ParticipantType\") AND (st.\"createdById\" = current_setting('app.current_user_id'::text, true))) OR (EXISTS ( SELECT 1\n           FROM split_participant sp\n          WHERE ((sp.\"transactionId\" = st.id) AND (sp.\"participantType\" = 'user'::\"ParticipantType\") AND (sp.\"participantId\" = current_setting('app.current_user_id'::text, true))))))))) OR (EXISTS ( SELECT 1\n   FROM settlement s\n  WHERE ((audit_log_entry.\"targetType\" = 'SETTLEMENT'::\"AuditTargetType\") AND (s.id = audit_log_entry.\"targetId\") AND (((s.\"fromParticipantType\" = 'user'::\"ParticipantType\") AND (s.\"fromParticipantId\" = current_setting('app.current_user_id'::text, true))) OR ((s.\"toParticipantType\" = 'user'::\"ParticipantType\") AND (s.\"toParticipantId\" = current_setting('app.current_user_id'::text, true)))))))) | ",
		"error_report error_report_delete_own d (\"userId\" = current_setting('app.current_user_id'::text, true)) | ",
		"error_report error_report_insert_own a  | (\"userId\" = current_setting('app.current_user_id'::text, true))",
		"error_report error_report_select_own r (\"userId\" = current_setting('app.current_user_id'::text, true)) | ",
		"session session_isolation * (\"userId\" = current_setting('app.current_user_id'::text, true)) | (\"userId\" = current_setting('app.current_user_id'::text, true))",
		"twoFactor two_factor_isolation * (\"userId\" = current_setting('app.current_user_id'::text, true)) | (\"userId\" = current_setting('app.current_user_id'::text, true))"
	],
	"defaults": [
		"<owner> public S retrospend_app:SELECT,retrospend_app:USAGE",
		"<owner> public r retrospend_app:DELETE,retrospend_app:INSERT,retrospend_app:SELECT,retrospend_app:UPDATE"
	]
}
